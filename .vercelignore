# Fichiers et dossiers à ignorer lors du déploiement Vercel

# Environnements virtuels
venv/
env/
.venv/

# Base de données locale
*.sqlite3
db.sqlite3

# Fichiers de cache Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Fichiers de développement
.env
.env.local
.env.development
.env.test

# Logs
*.log
logs/

# Fichiers temporaires
*.tmp
*.temp

# Fichiers de test
.coverage
htmlcov/
.pytest_cache/

# Fichiers IDE
.vscode/
.idea/
*.swp
*.swo

# Node modules (si utilisés)
node_modules/

# Fichiers de build locaux
staticfiles_build/
media/

# Git
.git/
.gitignore

# Docker
Dockerfile
docker-compose.yml
.dockerignore
